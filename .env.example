# Source this file before running Hardhat commands:
#   set -a && source .env && set +a

# Ethereum mainnet RPC endpoint (e.g. Alchemy / Infura)
MAINNET_RPC_URL=

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=

# NOTE: MAINNET_PRIVATE_KEY is intentionally NOT stored here. It lives in the
# Hardhat keystore, set via: npx hardhat keystore set MAINNET_PRIVATE_KEY
